@startuml rfc-b-c4-container
!pragma layout smetana
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title Вариант B. Delivery Orchestrator (C4: Container)

System_Ext(producers, "Продуктовые сервисы", "Платежи, переводы, карты, кредиты")
System_Ext(profile, "Customer Profile", "Мастер-данные: телефон, email")
System_Ext(app, "Мобильное приложение", "iOS / Android, отправляет ACK")
System_Ext(pushp, "Push-провайдеры", "FCM, APNs, HMS, RuStore")
System_Ext(smsA, "SMS-агрегатор A", "Основной, HTTP / SMPP")
System_Ext(smsB, "SMS-агрегатор B", "Резервный, HTTP / SMPP")
System_Ext(mailp, "Email relay", "SMTP")
System_Ext(obs, "Мониторинг", "Prometheus, Grafana, Tempo, Loki, Alertmanager")

System_Boundary(np, "Notification Platform: гарантированная доставка (вариант B)") {
  Container(ingest, "Ingest API", "Go, gRPC", "Приём, авторизация по категории, notification_id = UUIDv5, запись в Kafka")
  ContainerQueue(kafka, "Event Bus", "Apache Kafka (KRaft), RF=3", "notif.critical, cmd.push, cmd.sms, cmd.email, delivery.receipts, notification.events")
  Container(orch, "Delivery Orchestrator", "Go", "Машина состояний, план каналов, таймеры failover, transactional outbox")
  ContainerDb(statedb, "Delivery State DB", "PostgreSQL 16 + Patroni, синхронная реплика", "notifications, delivery_timers, receipts, attempts, outbox")
  Container(pref, "Preference & Device Service", "Go", "Настройки, устройства, push-токены, контакты")
  Container(tmpl, "Template Service", "Go", "Версионированные шаблоны, рендеринг")
  ContainerDb(redis, "Cache", "Redis Cluster", "Профили и шаблоны; не источник гарантий доставки")
  Container(push, "Push Sender", "Go", "FCM / APNs / HMS / RuStore, ack_token в payload")
  Container(sms, "SMS Sender", "Go", "Проверка актуальности, роутинг A/B, circuit breaker, rate limit")
  Container(email, "Email Sender", "Go", "Отправка email")
  Container(receipts, "Receipt Gateway", "Go, HTTP", "ACK приложения (HMAC), DLR-вебхуки, bounce")
  Container(status, "Status & Audit Service", "Go, gRPC", "Статус, история, события отправителям")
  ContainerDb(ch, "History & Audit", "ClickHouse", "События доставки, 3 года")
}

Rel(producers, ingest, "SendNotification", "gRPC, mTLS")
Rel(ingest, kafka, "notif.critical", "acks=all")
Rel(kafka, orch, "notif.critical, delivery.receipts")
Rel(orch, statedb, "Состояние, таймеры, outbox", "SQL / pgx")
Rel(orch, pref, "Профиль для плана", "gRPC")
Rel(orch, kafka, "cmd.*, notification.events")
Rel(pref, redis, "Кэш")
Rel(pref, profile, "Контакты", "REST")
Rel(kafka, push, "cmd.push")
Rel(kafka, sms, "cmd.sms")
Rel(kafka, email, "cmd.email")
Rel(push, pref, "Токены устройств", "gRPC")
Rel(sms, pref, "Телефон", "gRPC")
Rel(sms, tmpl, "Рендер текста", "gRPC")
Rel(push, tmpl, "Рендер текста", "gRPC")
Rel(sms, statedb, "Актуальность, аренда с owner, сохранённый результат и receipt outbox", "SQL / pgx")
Rel(push, pushp, "Push", "HTTP/2")
Rel(sms, smsA, "SMS", "HTTPS / SMPP")
Rel(sms, smsB, "SMS (резерв)", "HTTPS / SMPP")
Rel(email, mailp, "Email", "SMTP")
Rel(push, kafka, "Результат -> delivery.receipts")
Rel(sms, kafka, "Результат -> delivery.receipts")
Rel(email, kafka, "Результат -> delivery.receipts")
Rel(pushp, app, "Push")
Rel(app, receipts, "ACK получения", "HTTPS")
Rel(smsA, receipts, "DLR", "HTTPS webhook")
Rel(smsB, receipts, "DLR", "HTTPS webhook")
Rel(receipts, kafka, "delivery.receipts")
Rel(kafka, status, "notification.events")
Rel(status, ch, "История")
Rel(status, statedb, "Текущий статус", "read replica")
Rel(orch, obs, "Метрики, трейсы, логи (все контейнеры)", "OTLP")
@enduml
